# Server poslouchá jen na tomto zařízení. Pro přístup z domácí Wi-Fi změňte na 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# true = přijme pouze loopback a privátní LAN adresy (10/8, 172.16/12, 192.168/16, lokální IPv6).
LAN_ONLY=true

# Heslo pouze pro čtení. Skutečnou hodnotu nedávejte do veřejného repozitáře.
VIEWER_PASSWORD=change-me-viewer

# Silné a odlišné heslo pro zadávání a změny dat.
ADMIN_PASSWORD=change-me-admin

# Vygenerujte např.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret

DATABASE_PATH=./data/luzicka.sqlite
HOUSEHOLD_NAME=Lužická
SESSION_HOURS=12
