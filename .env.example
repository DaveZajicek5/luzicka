# Lokálně poslouchá pouze na tomto zařízení. Na Railway se HOST a PORT nastaví automaticky.
HOST=127.0.0.1
PORT=8787

# Lokálně true. Pro cloudové nasazení musí být false; na Railway je výchozí hodnota automaticky false.
LAN_ONLY=true

# Na Railway je Secure cookie automaticky zapnutá. Lokálně přes HTTP musí zůstat false.
SECURE_COOKIES=false

# Heslo pouze pro čtení. Skutečnou hodnotu nedávejte do veřejného repozitáře.
VIEWER_PASSWORD=change-me-viewer

# Silné a odlišné heslo pro zadávání a změny dat.
ADMIN_PASSWORD=change-me-admin

# Vygenerujte např.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# Na Railway se databáze automaticky uloží na připojený Volume.
DATABASE_PATH=./data/luzicka.sqlite
HOUSEHOLD_NAME=Lužická
SESSION_HOURS=12
